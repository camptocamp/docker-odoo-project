#!/usr/bin/env python3
"""Run a command while holding the marabunta lock.

Usage: with_marabunta_lock <command> [args...]

If the database does not exist yet, the command runs without the lock.
"""

import subprocess
import sys
from os import getenv
from time import sleep

import psycopg2
from marabunta.core import ApplicationLock
from marabunta.database import Database


class DBConfig:
    def __init__(self):
        self.db_host = getenv("DB_HOST")
        self.db_port = getenv("DB_PORT")
        self.db_user = getenv("DB_USER")
        self.db_password = getenv("DB_PASSWORD")
        self.database = getenv("DB_NAME")


def main(cmd):
    database = Database(DBConfig())
    try:
        lock_connection = psycopg2.connect(**database.dsn())
    except psycopg2.OperationalError as exc:
        if f'database "{database.name}" does not exist' not in str(exc):
            raise
        print("Database does not exist, running without lock")
        return subprocess.call(cmd)

    # Ending the transaction, when leaving the block, releases the lock
    with lock_connection:
        application_lock = ApplicationLock(lock_connection)
        application_lock.start()
        try:
            while not application_lock.acquired:
                sleep(0.5)
            return subprocess.call(cmd)
        finally:
            application_lock.stop = True
            application_lock.join()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
