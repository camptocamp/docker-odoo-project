#!/bin/bash
#
# Run unit tests of local modules
#
# mainly used from CI,
# it creates a database,
# if a cached dump of official and oca modules exists restore it
# and install the dependencies missing from it (without tests)
# otherwise install dependencies and create a dump to cache
# then install local addons
# runs tests on it and drops it.
#
# Arguments:
#   optional: name of the addons to test, separated by ,
#
# Environment variables:
#
# CREATE_DB_CACHE:
#   if set to "true", will create a dump named "odoo_test_$VERSION.dmp"
#
# LOAD_DB_CACHE:
#   if set to "false", will skip trying to reload cached dump named "odoo_test_$VERSION.dmp"
#
# SUBS_MD5:
#   value to tag the database dump. Will search for a dump named
#   "odoo_test_$SUBS_MD5.dmp" if not found it will create one.
#
set -e

# TODO: if we are not on CI, make a template then run tests on a copy
. db_cache_helpers.sh

LOCAL_CODE_PATH=${LOCAL_CODE_PATH:-/odoo/local-src}
ODOO_BIN_PATH=/odoo/src/odoo/odoo-bin  # Core image layout
if [ ! -e "$ODOO_BIN_PATH" ]; then
  ODOO_BIN_PATH=/odoo/src/odoo-bin
fi
COVERAGE=$(command -v coverage || true)

if [ -z $1 ]; then
  LOCAL_ADDONS=$(find ${LOCAL_CODE_PATH}/* -maxdepth 0 -type d -and -not -name server_environment_files -printf "%f\n" |
    awk -vORS=, '{print $1}' |
    sed 's/,$/\n/')
else
  LOCAL_ADDONS=$1
fi

ALL_DEPS_ADDONS=$(list_dependencies.py "$LOCAL_ADDONS")
# Ignore base_automation from dependencies to avoid its register hook
#  messing with MRO of modules to be installed after server restart
DEPS_ADDONS=${ALL_DEPS_ADDONS/",base_automation,"/","}

# Set default values
: ${CREATE_DB_CACHE:=false} ${LOAD_DB_CACHE:=true} ${CACHE_DIR:=/tmp/cachedb} ${DB_NAME:=odoo_test}

# Odoo parameters common to all the passes
ODOO_PARAMS=(--stop-after-init --workers=0 --database $DB_NAME --db-filter=$DB_NAME)

if [[ ! -z "$SUBS_MD5" ]]; then
  DUMP="$CACHE_DIR/odoo_test_$SUBS_MD5.dmp"
fi

echo "Submodule addons MD5 is: $SUBS_MD5"

DUMP_LOADED=0
if [ "$LOAD_DB_CACHE" != "false" ]; then
  db_restore "$DUMP" "$DB_NAME"
  if [ -f "$DUMP" ]; then
    echo "Use restored dump with official/OCA modules"
    DUMP_LOADED=1
  else
    echo "Reinstall all addons from scratch 🐢 🐢 🐢"
  fi
else
  echo "DB cache load disabled."
fi

if [ "$DUMP_LOADED" = 0 ]; then
  echo "🔨🔨 Install official/OCA modules 🔨🔨"
  unbuffer odoo "${ODOO_PARAMS[@]}" --log-level=warn -i ${DEPS_ADDONS}
  if [ "$CREATE_DB_CACHE" != "false" ]; then
    db_save $DB_NAME $DUMP
  fi
else
  # The dump is keyed on the submodules only: dependencies added to the local
  # modules since it was created are not installed yet. Install them here,
  # otherwise they (and their tests) would be installed in the tests-enabled pass.
  INSTALLED_ADDONS=$(psql -At -d $DB_NAME -c "SELECT name FROM ir_module_module WHERE state = 'installed'")
  MISSING_ADDONS=$(comm -23 <(tr ',' '\n' <<<"$DEPS_ADDONS" | sort -u) <(sort -u <<<"$INSTALLED_ADDONS") | paste -sd, -)
  if [ -n "$MISSING_ADDONS" ]; then
    echo "🔨🔨 Install official/OCA modules missing from the dump: ${MISSING_ADDONS} 🔨🔨"
    unbuffer odoo "${ODOO_PARAMS[@]}" --log-level=warn -i ${MISSING_ADDONS}
  fi
fi
echo "🔧🔧 Install local modules -- ${LOCAL_CODE_PATH} 🔧🔧"
TEST_PARAMS=("${ODOO_PARAMS[@]}" --test-enable --log-level=test --log-handler=:INFO -i ${LOCAL_ADDONS})
if [ -n "$COVERAGE" ]; then
  unbuffer "$COVERAGE" run --source="${LOCAL_CODE_PATH}" "${ODOO_BIN_PATH}" "${TEST_PARAMS[@]}"
else
  echo "Skip Code Coverage - not available"
  unbuffer odoo "${TEST_PARAMS[@]}"
fi

dropdb ${DB_NAME}
if [ -n "$COVERAGE" ]; then
 "$COVERAGE" report -m
fi
