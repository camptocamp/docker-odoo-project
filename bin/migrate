#!/bin/bash
set -e

. env_postgres.sh

if ! psql -lqtA | grep -q "^$DB_NAME|"; then
  createdb $DB_NAME
fi
MARABUNTA_DB_HOST=$DB_HOST \
  MARABUNTA_DATABASE=$DB_NAME \
  MARABUNTA_DB_USER=$DB_USER \
  MARABUNTA_DB_PASSWORD=$DB_PASSWORD \
  MARABUNTA_DB_PORT=$DB_PORT \
unbuffer marabunta --migration-file ${MIGRATION_CONFIG_FILE:=/odoo/migration.yml}
